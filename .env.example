# MediAlert Environment Variables
# Copy this to .env and fill in your values

# API Authentication
API_KEY=dev-secret

# Anthropic API Key (required for disease prediction)
# Get yours at: https://console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Database (SQLite for dev, change to postgres for prod)
# DATABASE_URL=postgresql://user:password@host:5432/medialert
DATABASE_URL=sqlite:///./data/medialert.db

# Frontend
VITE_API_URL=http://localhost:8000
VITE_API_KEY=dev-secret
